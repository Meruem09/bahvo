{
  "light": {
    "--mn-bg": "#fcfbfa",
    "--mn-surface": "#ffffff",
    "--mn-subtle": "#f5f3f0",
    "--mn-line": "#e9e6e2",
    "--mn-line-strong": "#d6d1cb",
    "--mn-fg": "#1c1917",
    "--mn-muted": "#78716c",
    "--mn-inverse": "#fcfbfa",
    "--mn-accent": "#f76b15",
    "--mn-accent-soft": "#feeadb",
    "--mn-danger": "#c0362c",
    "--mn-overlay": "rgb(28 25 23 / 0.28)",
    "--mn-shadow": "rgb(28 25 23 / 0.08)"
  },
  "dark": {
    "--mn-bg": "#0d0c0b",
    "--mn-surface": "#141210",
    "--mn-subtle": "#1c1a18",
    "--mn-line": "#28241f",
    "--mn-line-strong": "#3a3531",
    "--mn-fg": "#f5f3f0",
    "--mn-muted": "#a8a29e",
    "--mn-inverse": "#0d0c0b",
    "--mn-accent": "#ff7a2e",
    "--mn-accent-soft": "#3a2112",
    "--mn-danger": "#f2786d",
    "--mn-overlay": "rgb(0 0 0 / 0.6)",
    "--mn-shadow": "rgb(0 0 0 / 0.5)"
  },
  "theme": {
    "--color-mn-bg": "var(--mn-bg)",
    "--color-mn-surface": "var(--mn-surface)",
    "--color-mn-subtle": "var(--mn-subtle)",
    "--color-mn-line": "var(--mn-line)",
    "--color-mn-line-strong": "var(--mn-line-strong)",
    "--color-mn-fg": "var(--mn-fg)",
    "--color-mn-muted": "var(--mn-muted)",
    "--color-mn-inverse": "var(--mn-inverse)",
    "--color-mn-accent": "var(--mn-accent)",
    "--color-mn-accent-soft": "var(--mn-accent-soft)",
    "--color-mn-danger": "var(--mn-danger)",
    "--color-mn-overlay": "var(--mn-overlay)",
    "--font-mn": "var(--font-geist-sans, \"Geist\"), ui-sans-serif, system-ui, sans-serif",
    "--radius-mn-sm": "6px",
    "--radius-mn": "8px",
    "--radius-mn-lg": "12px",
    "--shadow-mn-sm": "0 1px 2px var(--mn-shadow)",
    "--shadow-mn-lg": "0 20px 48px -16px var(--mn-shadow)"
  }
}
